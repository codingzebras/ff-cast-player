  },
  {
   "n": 9,
   "file": "audio/track-9.wav",
   "loop": 0,
   "seconds": 3.9,
   "speaker": "Vicks",
   "line": "\u201cI heard she fried 50 of our Magitek Armored soldiers in under 3 min\u2026\u201d",
